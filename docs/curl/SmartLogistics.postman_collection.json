    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            },
            "description": "Is the process up? Deliberately touches nothing else.\n\nA liveness probe that checked the database would have Kubernetes restart\nevery pod whenever Postgres hiccuped, which fixes nothing and turns a\ndependency outage into an outage of everything."
          }
        },
        {
          "name": "Readiness probe \u2014 checks dependencies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/ready",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health",
                "ready"
              ],
              "query": []
            },
            "description": "Can this instance serve traffic?\n\nReturns 503 when it cannot. A readiness probe is read by its status code,\nso answering 200 with ``{\"status\": \"degraded\"}`` would leave a pod that\ncannot reach its database sitting in the load balancer taking requests."
          }
        }
      ]
    },
