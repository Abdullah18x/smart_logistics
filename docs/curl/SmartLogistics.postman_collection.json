                "api",
                "v1",
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "Repeated failures lock the account temporarily.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@transfleet.com\",\n  \"password\": \"SmartLogistics!2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('access_token', body.access_token);",
                  "  pm.environment.set('refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Exchange a refresh token for a new pair",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
