                "api",
                "v1",
                "auth",
                "refresh"
              ],
              "query": []
            },
            "description": "Refresh tokens rotate: the presented token is revoked and replaced.\n\nReplaying an already-rotated token revokes every session for that user, on\nthe assumption it was stolen.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"string\"\n}",
              "options": {
