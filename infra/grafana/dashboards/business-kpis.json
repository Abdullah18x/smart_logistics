      "id": 14
    },
    {
      "id": 15,
      "type": "table",
      "title": "Warehouse throughput",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "targets": [
        {
          "rawSql": "SELECT COALESCE(w.code, r.scope_id::text) AS warehouse, SUM(value) FILTER (WHERE metric = 'created') AS created, SUM(value) FILTER (WHERE metric = 'dispatched') AS dispatched, SUM(value) FILTER (WHERE metric = 'delivered') AS delivered, SUM(value) FILTER (WHERE metric = 'delivery_failed') AS failed, SUM(value) FILTER (WHERE metric = 'returned') AS returns, ROUND(SUM(value) FILTER (WHERE metric = 'delivery_seconds')::numeric / 3600 / NULLIF(SUM(value) FILTER (WHERE metric = 'delivered_timed'), 0), 1) AS avg_hours FROM daily_rollups r LEFT JOIN (SELECT warehouse_id, MAX(warehouse_code) AS code FROM shipments GROUP BY 1) w ON w.warehouse_id = r.scope_id WHERE scope = 'warehouse' AND day BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY 1 ORDER BY dispatched DESC NULLS LAST",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "table",
      "title": "Couriers",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "targets": [
        {
          "rawSql": "SELECT c.code, c.full_name, c.status, c.active_assignments AS active, c.max_active_shipments AS capacity, ROUND(c.active_assignments::numeric / NULLIF(c.max_active_shipments, 0), 2) AS utilisation, COALESCE(SUM(r.value) FILTER (WHERE r.metric = 'assigned'), 0) AS assigned, COALESCE(SUM(r.value) FILTER (WHERE r.metric = 'delivered'), 0) AS delivered FROM couriers c LEFT JOIN daily_rollups r ON r.scope = 'courier' AND r.scope_id = c.id AND r.day BETWEEN $__timeFrom()::date AND $__timeTo()::date WHERE NOT c.deleted GROUP BY c.id ORDER BY assigned DESC, c.code",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Pipeline issues",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
