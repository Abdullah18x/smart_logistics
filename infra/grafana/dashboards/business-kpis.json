    {
      "id": 8,
      "type": "stat",
      "title": "Average delivery time",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "targets": [
        {
          "rawSql": "SELECT SUM(value) FILTER (WHERE metric = 'delivery_seconds') / NULLIF(SUM(value) FILTER (WHERE metric = 'delivered_timed'), 0) AS value FROM daily_rollups WHERE scope = 'warehouse' AND day BETWEEN $__timeFrom()::date AND $__timeTo()::date",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Return rate (per dispatched)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "targets": [
        {
          "rawSql": "SELECT SUM(value) FILTER (WHERE metric = 'returned')::float / NULLIF(SUM(value) FILTER (WHERE metric = 'dispatched'), 0) AS value FROM daily_rollups WHERE scope = 'warehouse' AND day BETWEEN $__timeFrom()::date AND $__timeTo()::date",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Courier utilisation (now)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "targets": [
        {
          "rawSql": "SELECT SUM(active_assignments)::float / NULLIF(SUM(max_active_shipments), 0) AS value FROM couriers WHERE status = 'active' AND NOT deleted",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
