    {
      "id": 18,
      "type": "table",
      "title": "Latest issues",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "targets": [
        {
          "rawSql": "SELECT occurred_at AS time, kind, source, reason, event_type, status, detail FROM pipeline_issues WHERE $__timeFilter(occurred_at) ORDER BY occurred_at DESC LIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
