    {
      "id": 13,
      "type": "timeseries",
      "title": "Shipments per day",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "targets": [
        {
          "rawSql": "SELECT day::timestamptz AS time, metric, SUM(value) AS value FROM daily_rollups WHERE scope = 'warehouse' AND metric IN ('created', 'dispatched', 'delivered', 'delivery_failed', 'returned') AND day BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Warehouses and couriers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
