# Copy to .env and adjust. .env is git-ignored; this file is not.
# Only Week 1 variables are listed. Kafka, RabbitMQ, Temporal and the
# observability stack are added in their own weeks.

# ---------------------------------------------------------------- application
APP_NAME=SmartLogistics
ENVIRONMENT=local                 # local | test | staging | production
DEBUG=true

# ------------------------------------------------------------------ postgres
# Read by the application (async driver).
DATABASE_URL=postgresql+asyncpg://smartlogistics:smartlogistics@localhost:5432/smartlogistics
DATABASE_ECHO=false               # true logs every SQL statement
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Read by docker-compose to provision the container.
POSTGRES_USER=smartlogistics
POSTGRES_PASSWORD=smartlogistics
POSTGRES_DB=smartlogistics
POSTGRES_PORT=5432

# --------------------------------------------------------------------- mongo
# Full connection URI. Not containerised — point this at your own instance.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=smartlogistics

# --------------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ------------------------------------------------------------------ seeding
# Password assigned to every seeded account. Local development only.
SEED_DEFAULT_PASSWORD=SmartLogistics!2026
