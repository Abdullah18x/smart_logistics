# You rarely need this file: `./dev.sh start` (or dev.ps1 / dev.cmd) sets every
# variable below for each service. Copy to .env only to run one service by hand:
#
#   cd services/shipment && uv run uvicorn shipment.main:app --port 8004
#
# Without any variables the services already default to the Docker Compose
# databases on 5441-5445, Kafka on 29092, Temporal on 7233 and MongoDB on 27017.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# Each SQL service has its own database instance (compose publishes them on 5441-5445):
#   identity  postgresql+asyncpg://identity:identity@localhost:5441/identity
#   warehouse postgresql+asyncpg://warehouse:warehouse@localhost:5442/warehouse
#   inventory postgresql+asyncpg://inventory:inventory@localhost:5443/inventory
#   shipment  postgresql+asyncpg://shipment:shipment@localhost:5444/shipment
#   courier   postgresql+asyncpg://courier:courier@localhost:5445/courier
DATABASE_URL=

# Identity signs; everyone else verifies through the JWKS endpoint.
JWT_PRIVATE_KEY_FILE=infra/keys/jwt-private.pem
JWKS_URL=http://localhost:8001/.well-known/jwks.json

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service-to-service URLs
WAREHOUSE_SERVICE_URL=http://localhost:8002
INVENTORY_SERVICE_URL=http://localhost:8003
SHIPMENT_SERVICE_URL=http://localhost:8004
COURIER_SERVICE_URL=http://localhost:8005
TRACKING_SERVICE_URL=http://localhost:8007
IDENTITY_SERVICE_URL=http://localhost:8001

# Service accounts (development values; use real secrets anywhere shared).
#   identity:     the accepted clients, as JSON
#   orchestrator: its own credentials
SERVICE_CLIENTS={"orchestrator": "orchestrator-dev-secret"}
SERVICE_CLIENT_ID=orchestrator
SERVICE_CLIENT_SECRET=orchestrator-dev-secret

# Orchestrator (Temporal)
TEMPORAL_ADDRESS=localhost:7233
TASK_QUEUE=smartlogistics-dispatch
COURIER_WAIT_ATTEMPTS=5
COURIER_WAIT_SECONDS=60
PICKUP_TIMEOUT_SECONDS=14400
MAX_DELIVERY_ATTEMPTS=3

# Tracking (MongoDB)
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=tracking

SEED_DEFAULT_PASSWORD=SmartLogistics!2026
